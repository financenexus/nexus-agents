{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Agents",
  "version": "0.1.0",
  "identifier": "com.nexus.agents",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../out/renderer",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Agents",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["sidecar/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
